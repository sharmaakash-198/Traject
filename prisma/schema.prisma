generator client { provider = "prisma-client-js" }
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase 0 baseline only. Expand through reviewed migrations; see docs/DATA_MODEL.md.
enum ApplicationStatus { SAVED APPLIED SCREENING ASSESSMENT INTERVIEW OFFER ACCEPTED REJECTED WITHDRAWN ON_HOLD EXPIRED }
model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  normalizedName String @unique
  website String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  jobs Job[]
}
model Job {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  title String
  location String?
  canonicalUrl String?
  externalJobId String?
  descriptionText String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application[]
  @@index([companyId])
  @@index([canonicalUrl])
}
model Application {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  status ApplicationStatus @default(SAVED)
  appliedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  statusHistory ApplicationStatusHistory[]
  @@index([jobId])
  @@index([status])
}
model ApplicationStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  fromStatus ApplicationStatus?
  toStatus ApplicationStatus
  note String?
  changedAt DateTime @default(now()) @db.Timestamptz(6)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, changedAt])
}
